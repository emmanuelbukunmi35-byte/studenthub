<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StudentHub Quiz</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #2563eb, #7c3aed, #ec4899, #f97316);
    background-size: 400% 400%;
    animation: bg 10s ease infinite;
    min-height: 100vh;
    padding: 20px;
}

@keyframes bg {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.container {
    max-width: 750px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 22px;
    box-shadow: 0 10px 35px rgba(0,0,0,.25);
}

h1 {
    text-align: center;
    color: #4f46e5;
}

.subtitle {
    text-align: center;
    color: #64748b;
}

select,
button {
    width: 100%;
    padding: 14px;
    margin-top: 12px;
    border-radius: 12px;
    font-size: 16px;
}

select {
    border: 2px solid #ddd;
}

button {
    border: none;
    background: linear-gradient(90deg, #2563eb, #7c3aed);
    color: white;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    opacity: .9;
}

.timer {
    text-align: center;
    font-size: 24px;
    font-weight: bold;
    color: #dc2626;
    margin: 20px 0;
}

.question {
    background: #f8fafc;
    padding: 18px;
    margin: 18px 0;
    border-radius: 15px;
}

.option {
    display: block;
    background: white;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #ddd;
    border-radius: 10px;
}

.correct {
    background: #dcfce7 !important;
    border-color: #22c55e;
}

.wrong {
    background: #fee2e2 !important;
    border-color: #ef4444;
}

.correction {
    margin-top: 10px;
    padding: 10px;
    border-radius: 8px;
    background: #eef2ff;
    color: #3730a3;
}

#quizArea,
#result {
    display: none;
}

#result {
    text-align: center;
    margin-top: 20px;
}
</style>
</head>

<body>

<div class="container">

<h1>📚 StudentHub Quiz</h1>

<p class="subtitle">
Test your knowledge and improve your score.
</p>

<div id="setup">

    <label><b>Select Subject</b></label>

    <select id="subject">

        <option value="Physics">Physics</option>

        <option value="Mathematics">
            Mathematics
        </option>

        <option value="Chemistry">
            Chemistry
        </option>

        <option value="Biology">
            Biology
        </option>

        <option value="English">
            English
        </option>

        <option value="Computer Science">
            Computer Science
        </option>

    </select>

    <button onclick="startQuiz()">
        Start Quiz
    </button>

</div>

<div id="quizArea">

    <div class="timer">
        ⏱️ <span id="time">20:00</span>
    </div>

    <div id="questions"></div>

    <button onclick="submitQuiz()">
        Submit Quiz
    </button>

</div>

<div id="result"></div>

</div>

<script>

const questionBank = {

Physics: [

{
q:"What is the SI unit of force?",
a:["Newton","Joule","Watt","Pascal"],
c:0
},

{
q:"What is the acceleration due to gravity near Earth's surface?",
a:["9.8 m/s²","5 m/s²","20 m/s²","1.6 m/s²"],
c:0
},

{
q:"Which quantity has both magnitude and direction?",
a:["Scalar","Vector","Mass","Time"],
c:1
},

{
q:"What is the SI unit of energy?",
a:["Newton","Joule","Watt","Volt"],
c:1
},

{
q:"Which instrument measures electric current?",
a:["Voltmeter","Ammeter","Thermometer","Barometer"],
c:1
},

{
q:"What type of wave is sound in air?",
a:["Transverse","Longitudinal","Electromagnetic","Stationary"],
c:1
},

{
q:"What is the speed of light in vacuum approximately?",
a:[
"3 × 10⁸ m/s",
"3 × 10⁶ m/s",
"3 × 10⁴ m/s",
"3 × 10² m/s"
],
c:0
},

{
q:"Which law explains action and reaction forces?",
a:[
"Newton's First Law",
"Newton's Second Law",
"Newton's Third Law",
"Ohm's Law"
],
c:2
},

{
q:"What is the unit of power?",
a:["Joule","Newton","Watt","Pascal"],
c:2
},

{
q:"Which lens is thicker at the centre?",
a:[
"Concave lens",
"Convex lens",
"Plane lens",
"None"
],
c:1
}

],

Mathematics: [

{
q:"What is 12 × 8?",
a:["86","96","108","88"],
c:1
},

{
q:"What is the square root of 144?",
a:["10","11","12","14"],
c:2
},

{
q:"What is 25% of 200?",
a:["25","40","50","75"],
c:2
},

{
q:"Solve: x + 7 = 15.",
a:["6","7","8","9"],
c:2
},

{
q:"What is 3² + 4²?",
a:["12","20","25","49"],
c:2
},

{
q:"What is the perimeter of a square with side 5 cm?",
a:["10 cm","15 cm","20 cm","25 cm"],
c:2
},

{
q:"What is 0.5 as a fraction?",
a:["1/2","1/3","2/5","3/5"],
c:0
},

{
q:"What is the next prime number after 7?",
a:["8","9","10","11"],
c:3
},

{
q:"What is 15 + 27?",
a:["32","40","42","44"],
c:2
},

{
q:"What is 100 ÷ 4?",
a:["20","25","30","40"],
c:1
}

],

Chemistry: [

{
q:"What is the chemical symbol for oxygen?",
a:["O","Ox","Og","C"],
c:0
},

{
q:"What is the atomic number of hydrogen?",
a:["1","2","8","10"],
c:0
},

{
q:"What is H₂O commonly called?",
a:["Salt","Water","Hydrogen","Oxygen"],
c:1
},

{
q:"Which gas is needed for combustion?",
a:[
"Nitrogen",
"Oxygen",
"Carbon dioxide",
"Hydrogen"
],
c:1
},

{
q:"What is the pH of a neutral solution?",
a:["0","5","7","14"],
c:2
},

{
q:"Which particle has a negative charge?",
a:[
"Proton",
"Neutron",
"Electron",
"Nucleus"
],
c:2
},

{
q:"What is NaCl commonly called?",
a:[
"Sugar",
"Water",
"Common salt",
"Baking soda"
],
c:2
},

{
q:"Which state of matter has a fixed volume but no fixed shape?",
a:[
"Solid",
"Liquid",
"Gas",
"Plasma"
],
c:1
},

{
q:"What is CO₂?",
a:[
"Carbon monoxide",
"Carbon dioxide",
"Calcium oxide",
"Cobalt"
],
c:1
},

{
q:"Which gas makes up most of Earth's atmosphere?",
a:[
"Oxygen",
"Hydrogen",
"Nitrogen",
"Carbon dioxide"
],
c:2
}

],

Biology: [

{
q:"What is the basic unit of life?",
a:[
"Tissue",
"Organ",
"Cell",
"System"
],
c:2
},

{
q:"Which organ pumps blood around the body?",
a:[
"Liver",
"Heart",
"Lung",
"Kidney"
],
c:1
},

{
q:"Where does photosynthesis mainly occur?",
a:[
"Nucleus",
"Chloroplast",
"Mitochondrion",
"Ribosome"
],
c:1
},

{
q:"Which gas do plants absorb during photosynthesis?",
a:[
"Oxygen",
"Nitrogen",
"Carbon dioxide",
"Hydrogen"
],
c:2
},

{
q:"What carries oxygen in red blood cells?",
a:[
"Insulin",
"Haemoglobin",
"Plasma",
"Keratin"
],
c:1
},

{
q:"Which organ is mainly responsible for filtering blood?",
a:[
"Heart",
"Kidney",
"Stomach",
"Brain"
],
c:1
},

{
q:"What is the largest organ of the human body?",
a:[
"Heart",
"Skin",
"Liver",
"Brain"
],
c:1
},

{
q:"Which part of a plant absorbs water?",
a:[
"Flower",
"Leaf",
"Root",
"Fruit"
],
c:2
},

{
q:"Which blood cells help fight infection?",
a:[
"Red blood cells",
"White blood cells",
"Platelets",
"Plasma"
],
c:1
},

{
q:"What molecule carries genetic information?",
a:[
"DNA",
"Water",
"Glucose",
"Oxygen"
],
c:0
}

],

English: [

{
q:"Choose the correct sentence.",
a:[
"She go to school.",
"She goes to school.",
"She going school.",
"She gone school."
],
c:1
},

{
q:"What is the opposite of 'ancient'?",
a:[
"Old",
"Modern",
"Past",
"Historic"
],
c:1
},

{
q:"Which word is a noun?",
a:[
"Quickly",
