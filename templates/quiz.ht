],
c:3
},

{
q:"What is the past tense of 'go'?",
a:[
"Goed",
"Gone",
"Went",
"Going"
],
c:2
},

{
q:"Which word is a pronoun?",
a:[
"Table",
"He",
"Jump",
"Blue"
],
c:1
}

],

"Computer Science": [

{
q:"What does CPU stand for?",
a:[
"Central Processing Unit",
"Computer Personal Unit",
"Central Program Utility",
"Control Processing User"
],
c:0
},

{
q:"Which device is used to type text?",
a:[
"Monitor",
"Keyboard",
"Speaker",
"Printer"
],
c:1
},

{
q:"What does RAM stand for?",
a:[
"Random Access Memory",
"Read Access Machine",
"Rapid Action Memory",
"Random Application Module"
],
c:0
},

{
q:"Which is an operating system?",
a:[
"Windows",
"Google",
"HTML",
"Python"
],
c:0
},

{
q:"What is HTML mainly used for?",
a:[
"Creating web pages",
"Editing photos",
"Playing music",
"Scanning viruses"
],
c:0
},

{
q:"Which language is commonly used for programming?",
a:[
"Python",
"JPEG",
"HTML",
"Wi-Fi"
],
c:0
},

{
q:"What does URL stand for?",
a:[
"Uniform Resource Locator",
"Universal Radio Link",
"User Resource Line",
"Uniform Read Language"
],
c:0
},

{
q:"Which device displays computer output?",
a:[
"Keyboard",
"Mouse",
"Monitor",
"Microphone"
],
c:2
},

{
q:"What is malware?",
a:[
"A type of computer threat",
"A programming language",
"A monitor",
"A keyboard"
],
c:0
},

{
q:"Which one is a web browser?",
a:[
"Chrome",
"Windows",
"Linux",
"Android"
],
c:0
}

]

};


let currentQuestions = [];
let timer;
let timeLeft = 1200;
let submitted = false;


function shuffle(array) {

    return [...array].sort(
        () => Math.random() - 0.5
    );

}


function startQuiz() {

    const subject =
        document.getElementById("subject").value;

    /*
       Pick up to 20 random questions.
       When we add more questions later,
       this automatically uses 20 of them.
    */

    currentQuestions =
        shuffle(questionBank[subject]).slice(0, 20);

    submitted = false;

    document.getElementById("setup")
        .style.display = "none";

    document.getElementById("quizArea")
        .style.display = "block";

    document.getElementById("result")
        .style.display = "none";

    const box =
        document.getElementById("questions");

    box.innerHTML = "";

    currentQuestions.forEach(
        (item, index) => {

            let html = `
            <div class="question">

            <h3>
            ${index + 1}. ${item.q}
            </h3>
            `;

            item.a.forEach(
                (answer, optionIndex) => {

                    html += `
                    <label
                    class="option"
                    id="option-${index}-${optionIndex}">

                    <input
                    type="radio"
                    name="q${index}"
                    value="${optionIndex}">

                    ${answer}

                    </label>
                    `;

                }
            );

            html += `
            <div id="correction-${index}">
            </div>
            </div>
            `;

            box.innerHTML += html;

        }
    );

    startTimer();

}


function startTimer() {

    timeLeft = 1200;

    clearInterval(timer);

    updateTimer();

    timer = setInterval(
        () => {

            timeLeft--;

            updateTimer();

            if (timeLeft <= 0) {

                clearInterval(timer);

                submitQuiz();

            }

        },
        1000
    );

}


function updateTimer() {

    const minutes =
        Math.floor(timeLeft / 60);

    const seconds =
        timeLeft % 60;

    document.getElementById("time")
        .textContent =
        `${minutes}:${seconds
        .toString()
        .padStart(2, "0")}`;

}


function submitQuiz() {

    if (submitted) {
        return;
    }

    submitted = true;

    clearInterval(timer);

    let score = 0;

    currentQuestions.forEach(
        (item, index) => {

            const selected =
                document.querySelector(
                    `input[name="q${index}"]:checked`
                );

            const correction =
                document.getElementById(
                    `correction-${index}`
                );

            if (selected) {

                const answer =
                    Number(selected.value);

                if (answer === item.c) {

                    score++;

                    document
                    .getElementById(
                        `option-${index}-${answer}`
                    )
                    .classList.add("correct");

                    correction.innerHTML = `
                    <div class="correction">
                    ✓ Correct!
                    </div>
                    `;

                } else {

                    document
                    .getElementById(
                        `option-${index}-${answer}`
                    )
                    .classList.add("wrong");

                    document
                    .getElementById(
                        `option-${index}-${item.c}`
                    )
                    .classList.add("correct");

                    correction.innerHTML = `
                    <div class="correction">
                    Correct answer:
                    <b>${item.a[item.c]}</b>
                    </div>
                    `;

                }

            } else {

                document
                .getElementById(
                    `option-${index}-${item.c}`
                )
                .classList.add("correct");

                correction.innerHTML = `
                <div class="correction">
                Not answered.
                Correct answer:
                <b>${item.a[item.c]}</b>
                </div>
                `;

            }

        }
    );


    const subject =
        document.getElementById("subject").value;


    localStorage.setItem(
        "studenthub_last_quiz",

        JSON.stringify({

            subject: subject,

            score: score,

            total: currentQuestions.length,

            date: new Date().toLocaleString()

        })
    );


    const percentage =
        Math.round(
            (score / currentQuestions.length) * 100
        );


    const result =
        document.getElementById("result");

    result.style.display = "block";

    result.innerHTML = `

        <h2>🎉 Quiz Finished!</h2>

        <h3>
        Score: ${score}/${currentQuestions.length}
        </h3>

        <p>
        Percentage: ${percentage}%
        </p>

        <p>
        Your corrections are shown above.
        </p>

        <button onclick="location.reload()">
        Take Another Quiz
        </button>

    `;


    result.scrollIntoView({
        behavior: "smooth"
    });

}

</script>

</body>
</html>

