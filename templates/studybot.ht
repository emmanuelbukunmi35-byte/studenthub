<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyBot</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f2f5f8;
        }

        header {
            background: #1f6feb;
            color: white;
            padding: 18px;
            text-align: center;
        }

        .chat {
            max-width: 700px;
            margin: auto;
            padding: 15px;
        }

        #messages {
            background: white;
            min-height: 65vh;
            padding: 15px;
            border-radius: 12px;
            overflow-y: auto;
        }

        .message {
            padding: 12px;
            margin: 10px 0;
            border-radius: 10px;
            white-space: pre-wrap;
        }

        .user {
            background: #dbeafe;
            text-align: right;
        }

        .bot {
            background: #eeeeee;
        }

        .input-area {
            display: flex;
            gap: 8px;
            margin-top: 12px;
        }

        input {
            flex: 1;
            padding: 14px;
            border: 1px solid #ccc;
            border-radius: 10px;
            font-size: 16px;
        }

        button {
            padding: 14px 18px;
            border: none;
            border-radius: 10px;
            background: #1f6feb;
            color: white;
            font-size: 16px;
        }

        a {
            color: white;
        }
    </style>
</head>

<body>

<header>
    <h1>🤖 StudyBot</h1>
    <p>Ask me your school questions</p>
    <a href="/">⬅️ Back to StudentHub</a>
</header>

<div class="chat">

    <div id="messages">
        <div class="message bot">
            👋 Hello! I'm StudyBot.<br><br>
            Ask me a question about Physics, Mathematics, Chemistry,
            Biology, English, or Computer Science.
        </div>
    </div>

    <div class="input-area">
        <input
            type="text"
            id="messageInput"
            placeholder="Type your question..."
            autocomplete="off"
        >

        <button onclick="sendMessage()">Send</button>
    </div>

</div>

<script>

async function sendMessage() {

    const input = document.getElementById("messageInput");
    const messages = document.getElementById("messages");

    const message = input.value.trim();

    if (!message) {
        return;
    }

    // Show student's message
    const userMessage = document.createElement("div");
    userMessage.className = "message user";
    userMessage.textContent = message;
    messages.appendChild(userMessage);

    input.value = "";

    // Show thinking message
    const thinking = document.createElement("div");
    thinking.className = "message bot";
    thinking.textContent = "🤔 Thinking...";
    messages.appendChild(thinking);

    messages.scrollTop = messages.scrollHeight;

    try {

        const response = await fetch("/api/chat", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                message: message
            })
        });

        const data = await response.json();

        thinking.remove();

        const botMessage = document.createElement("div");
        botMessage.className = "message bot";

        if (data.reply) {
            botMessage.textContent = data.reply;
        } else {
            botMessage.textContent = "⚠️ StudyBot did not return an answer.";
        }

        messages.appendChild(botMessage);

    } catch (error) {

        thinking.textContent =
            "⚠️ Something went wrong. Please try again.";

        console.log(error);
    }

    messages.scrollTop = messages.scrollHeight;
}


// Press Enter to send
document.getElementById("messageInput").addEventListener(
    "keydown",
    function(event) {
        if (event.key === "Enter") {
            sendMessage();
        }
    }
);

</script>

</body>
</html>



